# --- REQUIRED: copy to .env and fill ---
# Comma- or newline-separated bot tokens. Token #1 = control bot (admin commands).
BOT_TOKENS=
# Your Telegram user id (message @userinfobot to get it). Only this id can control.
ADMIN_CHAT_ID=
# Deal channels (all deals / 70%+ / 90%+). 70/90 fall back to ALL if empty.
CHANNEL_ALL=
CHANNEL_70PLUS=
CHANNEL_90PLUS=
# --- OPTIONAL (defaults shown) ---
# DATA_DIR=./data
# PINCODE=387001
# Deal-link affiliate tag. EMPTY = OFF -> plain https://www.myntra.com/<ID>.
# Set later to e.g. utm_source=ugc_affiliate&utm_medium=social_share_pdp&utm_campaign=YOURTAG
# (or live via /set_affiliate — persists on the volume, no redeploy needed).
# AFFILIATE_TAG=
# CYCLE_DELAY=20
# SCRAPE_CONCURRENCY=20
# MAX_PAGES_PER_URL=5
# MIN_DISCOUNT_NEW=0
# MIN_DISCOUNT_EXISTING=15
# MIN_CHANGE_PERCENT=1
# CURL_IMPERSONATE=chrome131_android
# MAX_CYCLES=0
# LOG_LEVEL=INFO

# --- OPTIONAL: Croma scraper (runs alongside Myntra in the same deployment) ---
# CROMA_ENABLED=true
# CROMA_IMPERSONATE=chrome120
# CROMA_CHANNEL_CODE=400049
# CROMA_MAX_PAGES=10
# CROMA_CONCURRENCY=6
