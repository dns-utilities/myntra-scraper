# ==========================================================================
# dns-scraper — copy to .env and fill the REQUIRED block.
# Every value here is also its built-in default; uncomment to override.
# ==========================================================================

# --- REQUIRED ---
# Comma- or newline-separated bot tokens. Token #1 = control bot (admin commands).
# NOTE: every token gets its own Telegram long-poll thread, because a callback
# from a deal button is delivered to whichever bot POSTED that deal message.
BOT_TOKENS=
# Your Telegram user id (message @userinfobot to get it). Only this id can control.
ADMIN_CHAT_ID=

# --- REQUIRED: deal channels ---
# Two families, and every deal posts to exactly one of them:
#
#   base  CHANNEL_BASE_<SOURCE>  one feed per source, carrying that source's
#                                sub-tier (<70%) deals. A source with no base of
#                                its own inherits CHANNEL_BASE_DEFAULT.
#   tier  CHANNEL_TIER_<floor>   shared by every source, keyed by the band's
#                                floor percent: TIER_70 = 70-79%, TIER_80 =
#                                80-89%, TIER_90 = 90%+. Tiers are EXCLUSIVE —
#                                a tier deal never also lands in a base feed.
#                                A band left unset falls back to the dealing
#                                source's own base, so configuring just the
#                                bases is already a complete setup.
#
# A single-channel deployment sets only CHANNEL_BASE_DEFAULT (every base and
# every band inherits it). At least one destination must be set, or startup
# fails loudly rather than scrape forever and post nowhere.
CHANNEL_BASE_DEFAULT=
CHANNEL_BASE_MYNTRA=
CHANNEL_BASE_CROMA=
CHANNEL_BASE_BLINKIT=
CHANNEL_BASE_BIGBASKET=
CHANNEL_TIER_70=
CHANNEL_TIER_80=
CHANNEL_TIER_90=

# --- OPTIONAL: deal links / scraping defaults ---
# DATA_DIR=./data
# PINCODE=387001
# Deal-link affiliate tag. EMPTY = OFF -> plain https://www.myntra.com/<ID>.
# Set later to e.g. utm_source=ugc_affiliate&utm_medium=social_share_pdp&utm_campaign=YOURTAG
# (or live via /set_affiliate — persists on the volume, no redeploy needed).
# AFFILIATE_TAG=
# CYCLE_DELAY=20
# SCRAPE_CONCURRENCY=20
# MAX_PAGES_PER_URL=5
# MIN_DISCOUNT_NEW=0
# MIN_DISCOUNT_EXISTING=15
# MIN_CHANGE_PERCENT=1
# MAX_CYCLES=0
# LOG_LEVEL=INFO
# PORT=                          # Railway injects; health server answers "OK"

# --- Per-source tunables: SOURCE_<NAME>_<FIELD> ---
# Politeness is per-host: a burst at one site is what gets an IP throttled, so
# every site has its own budget. Unset = the built-in default shown below, which
# lives on the source's spec in sources.py — tuning a source never means editing
# code. Fields: ENABLED, INTERVAL, RPS, IMPERSONATE, PROXY, MIN_DISCOUNT_NEW,
# MIN_DISCOUNT_EXISTING, MAX_PAGES, CONCURRENCY, PAGE_LIMIT, COOLDOWN,
# COOKIE_TTL, WARM_COOKIES, CHANNEL_CODE.
#
# Myntra (national pricing)
# SOURCE_MYNTRA_RPS=5
# SOURCE_MYNTRA_INTERVAL=0
# SOURCE_MYNTRA_MAX_PAGES=5
# SOURCE_MYNTRA_CONCURRENCY=20
# SOURCE_MYNTRA_IMPERSONATE=chrome131_android   # Android-family, matches the Android UA
# SOURCE_MYNTRA_MIN_DISCOUNT_NEW=0
# SOURCE_MYNTRA_MIN_DISCOUNT_EXISTING=15
#
# Croma (national pricing)
# SOURCE_CROMA_ENABLED=true
# SOURCE_CROMA_RPS=5
# SOURCE_CROMA_MAX_PAGES=10
# SOURCE_CROMA_CONCURRENCY=6
# SOURCE_CROMA_IMPERSONATE=chrome120
# SOURCE_CROMA_CHANNEL_CODE=400049              # sales channel in the category API
#
# Blinkit (hyper-local, priced per delivery point)
# NOTE: Blinkit refuses cloud/datacenter IPs outright (every fingerprint gets a
# flat 403), so on a hosted box set SOURCE_BLINKIT_PROXY to a residential/ISP
# proxy. Direct works from a normal home connection.
# SOURCE_BLINKIT_ENABLED=true
# SOURCE_BLINKIT_RPS=3
# SOURCE_BLINKIT_MAX_PAGES=6
# SOURCE_BLINKIT_CONCURRENCY=5
# SOURCE_BLINKIT_IMPERSONATE=chrome136           # first fingerprint tried; the
#                                               # scraper falls back through a
#                                               # known-good list if refused
# SOURCE_BLINKIT_PAGE_LIMIT=15                  # cards per request
# SOURCE_BLINKIT_COOLDOWN=20                    # seconds parked after a 429/403
# SOURCE_BLINKIT_WARM_COOKIES=true
# SOURCE_BLINKIT_MIN_DISCOUNT_NEW=0             # 0 = post everything (single-store testing)
# SOURCE_BLINKIT_PROXY=http://user:pw@host:port  # optional egress (see note above)
#
# BigBasket (hyper-local, priced per delivery point)
# NOTE: /listing-svc is behind Akamai Bot Manager. It needs BOTH a residential
# IP and a real browser session — curl_cffi alone gets 403. Left unset, the
# source parks itself instead of hammering the wall.
# SOURCE_BIGBASKET_ENABLED=true
# SOURCE_BIGBASKET_RPS=4
# SOURCE_BIGBASKET_MAX_PAGES=5
# SOURCE_BIGBASKET_CONCURRENCY=8
# SOURCE_BIGBASKET_IMPERSONATE=chrome
# SOURCE_BIGBASKET_COOLDOWN=25
# SOURCE_BIGBASKET_COOKIE_TTL=600
# SOURCE_BIGBASKET_MIN_DISCOUNT_NEW=0
# SOURCE_BIGBASKET_PROXY=http://user:pw@host:port # optional egress (see note above)

# --- Hyper-local delivery points (Blinkit, BigBasket) ---
# Both are keyword/category driven like the others, but each price belongs to a
# delivery point, so each has its own locations file:
#   data/blinkit_locations.txt    lat | lon | name      (or  pin:132103 | Panipat)
#   data/bigbasket_locations.txt  ec | sa | city | name (or  pin:134114 | Ambala)
# Seeded from config/ on first boot and live-editable with /add_location.
# Blinkit pins resolve automatically (geocoded once, then cached on the volume);
# BigBasket pins need an explicit ec/sa/city line — the file header explains how.
# GEOCODE_ENABLED=true
# GEOCODE_URL=https://nominatim.openstreetmap.org/search

# --- Auto-clear: re-post deep discounts from good brands on a cooldown ---
# A deal from an evidenced registry brand at >= AUTO_CLEAR_MIN_DISCOUNT may
# re-post once AUTO_CLEAR_HOURS has passed since its last post, even at the
# same price — so long-running deals cycle instead of posting once and dying.
# Two guards stop it becoming spam: a per-hour cap on re-posts (so a restart
# drains instead of firing hundreds at once) and per-product cooldown jitter
# (so daily re-posts spread out instead of clustering at the top of the hour).
# Brand list: config/auto_clear_brands.json (seeded to the volume on first boot,
# live-editable with /autoclear_add and /autoclear_remove).
# AUTO_CLEAR_ENABLED=true
# AUTO_CLEAR_HOURS=24
# AUTO_CLEAR_MIN_DISCOUNT=50
# AUTO_CLEAR_MAX_PER_HOUR=25
# AUTO_CLEAR_JITTER_HOURS=6

# --- Housekeeping ---
# Seen rows not notified within this window are pruned once per PRUNE_INTERVAL_HOURS.
# SEEN_RETENTION_DAYS=45
# PRUNE_INTERVAL_HOURS=24

# --- Telegram send pacing (the anti-flood gate) ---
# A burst drains at Telegram's pace, never ours. The per-chat ceiling is the
# one that actually bites: ~20 messages/minute is Telegram's limit for one
# channel, so it is set just under that. SEND_MAX_QUEUE caps memory; beyond it
# deals are dropped and counted rather than queued forever. Unsent messages are
# written to data/outbox.jsonl on shutdown and re-queued on the next boot.
# SEND_GLOBAL_PER_SEC=20
# SEND_PER_BOT_PER_SEC=15
# SEND_PER_CHAT_PER_MIN=18
# SEND_MAX_QUEUE=5000
# BASELINE_ON_EMPTY=true            # first cycle over an empty DB records, never posts
